    'valentine-gift.svg': "{{ 'bp-ornament-valentine-gift.svg' | asset_url }}",
    'new-year-fireworks.svg': "{{ 'bp-ornament-new-year-fireworks.svg' | asset_url }}",
    'spring-bloom.svg': "{{ 'bp-ornament-spring-bloom.svg' | asset_url }}",
    'halloween-bats.svg': "{{ 'bp-ornament-halloween-bats.svg' | asset_url }}",
