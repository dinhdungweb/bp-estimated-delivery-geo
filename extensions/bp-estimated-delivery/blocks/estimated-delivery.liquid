{% comment %}
  BP: Estimated Delivery Pro — App Block (Mirror-Logic Version)
  Consolidated Version: Now uses bp-delivery-embed.js for 100% parity.
{% endcomment %}

{{ 'bp-delivery.css' | asset_url | stylesheet_tag }}

{% assign bp_delivery_variant = product.selected_or_first_available_variant %}
{% assign bp_delivery_inventory_status = 'out_of_stock_stop' %}
{% if bp_delivery_variant.inventory_quantity > 0 %}
  {% assign bp_delivery_inventory_status = 'in_stock' %}
{% elsif bp_delivery_variant.inventory_policy == 'continue' %}
  {% assign bp_delivery_inventory_status = 'out_of_stock_continue' %}
{% endif %}

<div id="bp-delivery-block-content" 
     data-shop="{{ shop.permanent_domain }}"
     data-product-id="{{ product.id }}"
     data-product-title="{{ product.title | escape }}"
     data-product-price-cents="{{ bp_delivery_variant.price }}"
     data-currency-code="{{ cart.currency.iso_code | default: shop.currency }}"
     data-product-tags="{{ product.tags | join: ',' }}"
     data-product-collections="{{ product.collections | map: 'id' | join: ',' }}"
     data-inventory-status="{{ bp_delivery_inventory_status }}"
     style="display:none; min-height: 100px; margin: 15px 0;">
  <div class="bp-skeleton" id="bp-delivery-block-content-skeleton" style="width:100%; height:120px; background:#f5f5f5; border-radius:12px; animation: bp-skeleton 1.5s infinite ease-in-out;"></div>
</div>

<script src="{{ 'bp-delivery-embed.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Estimated Delivery Pro",
  "target": "section",
  "settings": []
}
{% endschema %}
